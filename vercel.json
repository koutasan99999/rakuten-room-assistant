{
  "functions": {
    "api/discover.js": {
      "maxDuration": 60
    },
    "api/instagram.js": {
      "maxDuration": 30
    },
    "api/ideas.js": {
      "maxDuration": 60
    },
    "api/explore.js": {
      "maxDuration": 60
    },
    "api/intros.js": {
      "maxDuration": 60
    },
    "api/seed-ideas.js": {
      "maxDuration": 60
    },
    "api/assets.js": {
      "maxDuration": 60
    },
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/room-hashtags.js": {
      "maxDuration": 60
    },
    "api/release-ideas.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
